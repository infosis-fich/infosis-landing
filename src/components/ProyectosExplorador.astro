---
interface Props {
  vista?: "resumen" | "completa";
}

const { vista = "completa" } = Astro.props;
const esResumen = vista === "resumen";
const anioActual = new Date().getFullYear();
const aniosProyecto = Array.from(
  { length: anioActual - 1980 + 1 },
  (_, indice) => anioActual - indice,
);
---

<section
  class:list={[
    esResumen ? "seccion-resumen" : "seccion-institucional",
    "border-y border-border-subtle",
    esResumen ? "bg-card-bg" : "bg-surface-muted",
  ]}
  id={esResumen ? "proyectos" : undefined}
  aria-labelledby={esResumen
    ? "proyectos-titulo"
    : "explorador-proyectos-titulo"}
  data-projects-explorer
  data-projects-view={vista}
>
  <div class="contenedor-pagina">
    <div class="mb-7">
      {
        esResumen && (
          <span class="forma-acento mb-5 inline-flex items-center border border-sky/30 bg-sky/10 px-3 py-2 text-xs font-bold tracking-[.12em] text-sky uppercase">
            Repositorio de proyectos
          </span>
        )
      }
      {
        esResumen ? (
          <h2
            class="mb-4 max-w-[1100px] font-heading text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[1.1] tracking-[-.025em]"
            id="proyectos-titulo"
          >
            Proyectos académicos y de grado
          </h2>
        ) : (
          <h1
            class="mb-4 max-w-[1100px] font-heading text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[1.1] tracking-[-.025em]"
            id="explorador-proyectos-titulo"
          >
            Proyectos académicos y de grado
          </h1>
        )
      }
      <p class="mb-0 max-w-[640px] text-base leading-7 text-text-muted">
        Consulta proyectos académicos y de grado de Informática y Sistemas.
      </p>
    </div>

    <div class="grid gap-4">
      {
        !esResumen && (
          <form
            class="grid gap-3 border-b border-border-subtle pb-3"
            data-projects-filters
          >
            <div class="flex gap-2 max-[560px]:flex-col">
              <label class="sr-only" for="proyectos-titulo-filtro">
                Buscar por título
              </label>
              <input
                class="campo-formulario min-w-0 flex-1"
                id="proyectos-titulo-filtro"
                name="titulo"
                type="search"
                placeholder="Buscar por título..."
              />
              <button
                class="boton-principal cursor-pointer shrink-0 justify-center"
                type="submit"
              >
                Buscar <span aria-hidden="true">→</span>
              </button>
            </div>
            <div class="hidden items-center justify-between gap-3 text-xs text-text-muted max-[560px]:flex">
              <button
                class="boton-secundario cursor-pointer px-3 py-2 text-sm"
                type="button"
                data-projects-filters-toggle
                aria-expanded="false"
                aria-controls="proyectos-filtros-avanzados"
              >
                Filtros
                <span
                  class="hidden inline-flex h-5 min-w-5 items-center justify-center bg-sky px-1.5 text-[.7rem] font-bold text-brand-deep"
                  data-projects-filters-count
                  aria-hidden="true"
                />
              </button>
              <button
                class="cursor-pointer font-semibold text-sky hover:text-text-on-inverse"
                type="reset"
                data-projects-clear
              >
                Limpiar filtros
              </button>
            </div>
            <div
              class="grid grid-cols-[minmax(12rem,1.2fr)_minmax(12rem,1.2fr)_minmax(8rem,.7fr)_minmax(8rem,.7fr)_minmax(9rem,.8fr)] gap-2 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1"
              id="proyectos-filtros-avanzados"
              data-projects-advanced
            >
              <label class="sr-only" for="proyectos-autor-filtro">
                Buscar por autor
              </label>
              <input
                class="campo-formulario"
                id="proyectos-autor-filtro"
                name="autor"
                type="search"
                placeholder="Buscar por autor..."
              />
              <label class="sr-only" for="proyectos-materia-filtro">
                Buscar por materia
              </label>
              <input
                class="campo-formulario"
                id="proyectos-materia-filtro"
                name="materia"
                type="search"
                placeholder="Buscar por materia..."
              />
              <label class="sr-only" for="proyectos-tipo-filtro">
                Filtrar por tipo
              </label>
              <select
                class="campo-formulario"
                id="proyectos-tipo-filtro"
                name="tipo"
                aria-label="Filtrar por tipo"
              >
                <>
                  <option value="">Tipo</option>
                  <option value="ACA">Proyecto académico</option>
                  <option value="GRA">Proyecto de grado</option>
                </>
              </select>
              <label class="sr-only" for="proyectos-anio-filtro">
                Filtrar por año
              </label>
              <select
                class="campo-formulario h-12 max-h-12"
                id="proyectos-anio-filtro"
                name="anio"
                aria-label="Filtrar por año"
              >
                <option value="">Año</option>
                {aniosProyecto.map((anio) => (
                  <option value={anio}>{anio}</option>
                ))}
              </select>
              <label class="sr-only" for="proyectos-mes-filtro">
                Filtrar por mes
              </label>
              <select
                class="campo-formulario"
                id="proyectos-mes-filtro"
                name="mes"
                aria-label="Filtrar por mes"
              >
                <>
                  <option value="">Mes</option>
                  <option value="1">Enero</option>
                  <option value="2">Febrero</option>
                  <option value="3">Marzo</option>
                </>
                <>
                  <option value="4">Abril</option>
                  <option value="5">Mayo</option>
                  <option value="6">Junio</option>
                  <option value="7">Julio</option>
                </>
                <>
                  <option value="8">Agosto</option>
                  <option value="9">Septiembre</option>
                  <option value="10">Octubre</option>
                  <option value="11">Noviembre</option>
                  <option value="12">Diciembre</option>
                </>
              </select>
            </div>
            <div class="flex items-center justify-end gap-3 text-xs text-text-muted max-[560px]:hidden">
              <button
                class="cursor-pointer font-semibold text-sky hover:text-text-on-inverse"
                type="reset"
                data-projects-clear
              >
                Limpiar filtros
              </button>
            </div>
          </form>
        )
      }

      <div class="min-w-0">
        <div
          class="mb-3 flex items-center justify-between gap-4 max-[520px]:items-start max-[520px]:flex-col"
        >
          <p
            class="m-0 text-sm text-text-muted"
            data-projects-summary
            aria-live="polite"
          >
            Cargando proyectos…
          </p>
          {
            esResumen && (
              <a
                class="boton-secundario cursor-pointer px-3.5 py-2 text-sm"
                href="/proyectos"
              >
                Explorar todos <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
        <div
          class="grid grid-cols-1 gap-5"
          data-projects-list
          aria-live="polite"
          aria-busy="true"
        >
          <article
            class="grid min-h-[14.5rem] grid-cols-[10rem_1fr] overflow-hidden border border-border-subtle bg-card-bg max-[900px]:min-h-[12rem] max-[900px]:grid-cols-[8rem_1fr] max-[560px]:min-h-0 max-[560px]:grid-cols-[5.5rem_1fr]"
            aria-hidden="true"
          >
            <div
              class="col-start-1 animate-pulse bg-skeleton max-[560px]:aspect-[.707/1] min-[561px]:row-span-2"
            >
            </div>
            <div
              class="col-start-2 row-start-1 flex min-w-0 flex-col justify-center gap-3 p-4 min-[561px]:p-6"
            >
              <div class="h-3 w-28 animate-pulse bg-skeleton"></div>
              <div class="h-7 w-4/5 animate-pulse bg-skeleton"></div>
            </div>
            <div
              class="col-span-2 col-start-1 row-start-2 min-w-0 p-4 min-[561px]:col-span-1 min-[561px]:col-start-2 min-[561px]:px-6 min-[561px]:pb-6 min-[561px]:pt-0"
            >
              <div
                class="grid gap-2 border-t border-border-subtle pt-3 max-[560px]:border-t-0 max-[560px]:pt-0"
              >
                <div class="h-3 w-full animate-pulse bg-skeleton"></div>
                <div class="h-3 w-3/4 animate-pulse bg-skeleton"></div>
                <div class="h-3 w-1/2 animate-pulse bg-skeleton"></div>
              </div>
            </div>
          </article>
          <article
            class="grid min-h-[14.5rem] grid-cols-[10rem_1fr] overflow-hidden border border-border-subtle bg-card-bg max-[900px]:min-h-[12rem] max-[900px]:grid-cols-[8rem_1fr] max-[560px]:min-h-0 max-[560px]:grid-cols-[5.5rem_1fr]"
            aria-hidden="true"
          >
            <div
              class="col-start-1 animate-pulse bg-skeleton max-[560px]:aspect-[.707/1] min-[561px]:row-span-2"
            >
            </div>
            <div
              class="col-start-2 row-start-1 flex min-w-0 flex-col justify-center gap-3 p-4 min-[561px]:p-6"
            >
              <div class="h-3 w-28 animate-pulse bg-skeleton"></div>
              <div class="h-7 w-4/5 animate-pulse bg-skeleton"></div>
            </div>
            <div
              class="col-span-2 col-start-1 row-start-2 min-w-0 p-4 min-[561px]:col-span-1 min-[561px]:col-start-2 min-[561px]:px-6 min-[561px]:pb-6 min-[561px]:pt-0"
            >
              <div
                class="grid gap-2 border-t border-border-subtle pt-3 max-[560px]:border-t-0 max-[560px]:pt-0"
              >
                <div class="h-3 w-full animate-pulse bg-skeleton"></div>
                <div class="h-3 w-3/4 animate-pulse bg-skeleton"></div>
                <div class="h-3 w-1/2 animate-pulse bg-skeleton"></div>
              </div>
            </div>
          </article>
        </div>
        <div
          class="mt-7 flex flex-wrap items-center justify-center gap-3"
          data-projects-pagination
        >
        </div>
      </div>
    </div>

    <p
      class="mt-5 hidden border border-accent/40 bg-accent/10 px-4 py-3 text-sm leading-6 text-text-primary"
      data-projects-status
      role="status"
      aria-live="polite"
    >
    </p>
  </div>
</section>

<script>
  import { listarProyectos } from "../lib/proyectos-api";
  import type { FiltrosProyectos, Proyecto } from "../tipos/proyectos";

  const root = document.querySelector<HTMLElement>("[data-projects-explorer]");
  if (root) {
    const preview = root.dataset.projectsView === "resumen";
    const list = root.querySelector<HTMLElement>("[data-projects-list]");
    const summary = root.querySelector<HTMLElement>("[data-projects-summary]");
    const pagination = root.querySelector<HTMLElement>(
      "[data-projects-pagination]",
    );
    const status = root.querySelector<HTMLElement>("[data-projects-status]");
    const filters = root.querySelector<HTMLFormElement>(
      "[data-projects-filters]",
    );
    const advancedFilters = root.querySelector<HTMLElement>(
      "[data-projects-advanced]",
    );
    const filtersToggle = root.querySelector<HTMLButtonElement>(
      "[data-projects-filters-toggle]",
    );
    const filtersCount = root.querySelector<HTMLElement>(
      "[data-projects-filters-count]",
    );
    const mobileQuery = window.matchMedia("(max-width: 560px)");
    let paginaActual = 1;

    const escapar = (texto: string) =>
      texto.replace(
        /[&<>'"]/g,
        (caracter) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            "'": "&#39;",
            '"': "&quot;",
          })[caracter] ?? caracter,
      );
    const nombreCompleto = (nombres: string, apellidos: string) =>
      `${nombres} ${apellidos}`.trim();
    const tipoTexto = (tipo: Proyecto["tipo"]) =>
      tipo === "ACA" ? "Proyecto académico" : "Proyecto de grado";
    const fechaTexto = (fecha: string | null) =>
      fecha
        ? new Intl.DateTimeFormat("es-BO", { dateStyle: "medium" }).format(
            new Date(fecha),
          )
        : "Fecha no disponible";
    const setStatus = (mensaje: string, visible = true) => {
      if (!status) return;
      status.textContent = mensaje;
      status.classList.toggle("hidden", !visible);
    };
    const resumenPublicados = (cantidad: number) =>
      cantidad === 0
        ? "Aún no hay proyectos publicados."
        : cantidad === 1
          ? "Último proyecto publicado"
          : `Últimos ${cantidad} proyectos publicados`;
    const skeletons = () => `
      ${[1, 2]
        .map(
          () => `
        <article class="grid min-h-[14.5rem] grid-cols-[10rem_1fr] overflow-hidden border border-border-subtle bg-card-bg max-[900px]:min-h-[12rem] max-[900px]:grid-cols-[8rem_1fr] max-[560px]:min-h-0 max-[560px]:grid-cols-[5.5rem_1fr]" aria-hidden="true">
          <div class="col-start-1 animate-pulse bg-skeleton max-[560px]:aspect-[.707/1] min-[561px]:row-span-2"></div>
          <div class="col-start-2 row-start-1 flex min-w-0 flex-col justify-center gap-3 p-4 min-[561px]:p-6">
            <div class="h-3 w-28 animate-pulse bg-skeleton"></div>
            <div class="h-7 w-4/5 animate-pulse bg-skeleton"></div>
          </div>
          <div class="col-span-2 col-start-1 row-start-2 min-w-0 p-4 min-[561px]:col-span-1 min-[561px]:col-start-2 min-[561px]:px-6 min-[561px]:pb-6 min-[561px]:pt-0">
            <div class="grid gap-2 border-t border-border-subtle pt-3 max-[560px]:border-t-0 max-[560px]:pt-0">
              <div class="h-3 w-full animate-pulse bg-skeleton"></div>
              <div class="h-3 w-3/4 animate-pulse bg-skeleton"></div>
              <div class="h-3 w-1/2 animate-pulse bg-skeleton"></div>
            </div>
          </div>
        </article>`,
        )
        .join("")}`;

    const tarjeta = (proyecto: Proyecto) => `
      <article class="forma-acento group grid min-h-[14.5rem] grid-cols-[10rem_1fr] items-stretch overflow-hidden border border-border-subtle ${preview ? "bg-surface-muted" : "bg-card-bg"} transition-[box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none max-[900px]:min-h-[12rem] max-[900px]:grid-cols-[8rem_1fr] max-[560px]:min-h-0 max-[560px]:grid-cols-[5.5rem_1fr]">
        <a class="relative col-start-1 row-start-1 block w-full cursor-pointer overflow-hidden bg-brand-deep focus-visible:z-10 focus-visible:outline-3 focus-visible:outline-offset-[-3px] focus-visible:outline-accent max-[560px]:aspect-[.707/1] min-[561px]:row-span-2" href="${escapar(proyecto.pdfUrl)}" target="_blank" rel="noreferrer" aria-label="Visualizar proyecto en PDF: ${escapar(proyecto.titulo)}">
          <img class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.025] motion-reduce:transition-none" src="${escapar(proyecto.miniaturaUrl)}" alt="Portada del proyecto ${escapar(proyecto.titulo)}" loading="lazy" decoding="async" />
          <span class="pointer-events-none absolute right-1.5 bottom-1.5 bg-sky px-1.5 py-0.5 text-[.6rem] font-bold tracking-[.1em] text-brand-deep uppercase" aria-hidden="true">PDF</span>
        </a>
        <div class="col-start-2 row-start-1 flex min-w-0 flex-col justify-center p-4 min-[561px]:p-6">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold text-text-muted max-[560px]:flex-col max-[560px]:items-start max-[560px]:gap-y-0.5">
            <span class="text-sky uppercase">${tipoTexto(proyecto.tipo)}</span>
            <span>Publicado el ${escapar(fechaTexto(proyecto.fechaPublicacion))}</span>
          </div>
          <h3 class="mt-2 mb-0 max-w-4xl font-display text-xl font-semibold leading-snug text-text-primary max-[560px]:text-lg"><a class="cursor-pointer transition-colors hover:text-sky focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-accent" href="/proyectos/${encodeURIComponent(proyecto.id)}">${escapar(proyecto.titulo)}</a></h3>
        </div>
        <div class="col-span-2 col-start-1 row-start-2 min-w-0 p-4 min-[561px]:col-span-1 min-[561px]:col-start-2 min-[561px]:px-6 min-[561px]:pb-6 min-[561px]:pt-0 max-[560px]:border-t max-[560px]:border-border-subtle">
          <dl class="m-0 grid gap-x-6 gap-y-2 border-t border-border-subtle pt-3 text-sm max-[560px]:border-t-0 max-[560px]:pt-0 sm:grid-cols-2">
            <div class="sm:col-span-2"><dt class="mb-0.5 font-semibold text-text-muted">Autores</dt><dd class="leading-5">${escapar(proyecto.autores.map((autor) => nombreCompleto(autor.nombres, autor.apellidos)).join(", "))}</dd></div>
            <div><dt class="mb-0.5 font-semibold text-text-muted">Tutor</dt><dd class="leading-5">${escapar(nombreCompleto(proyecto.tutor.nombres, proyecto.tutor.apellidos))}</dd></div>
            ${proyecto.materia ? `<div><dt class="mb-0.5 font-semibold text-text-muted">Materia</dt><dd class="leading-5">${escapar(proyecto.materia.codigo)} - ${escapar(proyecto.materia.nombre)}</dd></div>` : ""}
          </dl>
        </div>
      </article>`;

    const filtrosActuales = (): FiltrosProyectos => {
      if (!filters) return {};
      const datos = new FormData(filters);
      return Object.fromEntries(
        [...datos.entries()].filter(([, valor]) => valor !== ""),
      ) as FiltrosProyectos;
    };
    const camposAvanzados: Array<keyof FiltrosProyectos> = [
      "autor",
      "materia",
      "tipo",
      "anio",
      "mes",
    ];
    const filtrosAvanzadosActivos = () => {
      const filtros = filtrosActuales();
      return camposAvanzados.filter((campo) => Boolean(filtros[campo])).length;
    };
    const actualizarIndicadorFiltros = () => {
      if (!filtersCount) return;
      const activos = filtrosAvanzadosActivos();
      filtersCount.textContent = String(activos);
      filtersCount.classList.toggle("hidden", activos === 0);
      filtersToggle?.setAttribute(
        "aria-label",
        activos > 0
          ? `Filtros, ${activos} activo${activos === 1 ? "" : "s"}`
          : "Filtros",
      );
    };
    const mostrarFiltrosAvanzados = (visible: boolean) => {
      if (!advancedFilters) return;
      advancedFilters.style.display = visible ? "" : "none";
      filtersToggle?.setAttribute("aria-expanded", String(visible));
    };
    const cargarFiltrosDesdeUrl = () => {
      if (!filters) return;
      const parametros = new URLSearchParams(window.location.search);
      ["titulo", "tipo", "autor", "materia", "anio", "mes"].forEach(
        (nombre) => {
          const campo = filters.elements.namedItem(nombre);
          if (
            campo instanceof HTMLInputElement ||
            campo instanceof HTMLSelectElement
          ) {
            campo.value = parametros.get(nombre) ?? "";
          }
        },
      );
    };
    const guardarFiltrosEnUrl = (filtros: FiltrosProyectos) => {
      if (preview) return;
      const url = new URL(window.location.href);
      url.search = "";
      Object.entries(filtros).forEach(([clave, valor]) => {
        if (valor !== undefined && valor !== "")
          url.searchParams.set(clave, String(valor));
      });
      window.history.replaceState({}, "", url);
    };

    const renderizarPaginacion = (totalPaginas: number) => {
      if (!pagination || preview || totalPaginas <= 1) {
        if (pagination) pagination.innerHTML = "";
        return;
      }
      pagination.innerHTML = `
        <button class="boton-secundario px-3 py-2 text-sm disabled:opacity-40" type="button" data-page="${paginaActual - 1}" ${paginaActual <= 1 ? "disabled" : ""}>Anterior</button>
        <span class="px-2 text-sm text-text-muted">Página ${paginaActual} de ${totalPaginas}</span>
        <button class="boton-secundario px-3 py-2 text-sm disabled:opacity-40" type="button" data-page="${paginaActual + 1}" ${paginaActual >= totalPaginas ? "disabled" : ""}>Siguiente</button>`;
      pagination
        .querySelectorAll<HTMLButtonElement>("[data-page]")
        .forEach((boton) =>
          boton.addEventListener("click", () => {
            paginaActual = Number(boton.dataset.page);
            cargarProyectos();
            root.scrollIntoView({ behavior: "smooth", block: "start" });
          }),
        );
    };

    const cargarProyectos = async () => {
      if (!list) return;
      list.setAttribute("aria-busy", "true");
      list.innerHTML = skeletons();
      setStatus("", false);
      try {
        const filtros = preview
          ? { pagina: 1, tamanoPagina: 2 }
          : { ...filtrosActuales(), pagina: paginaActual, tamanoPagina: 9 };
        const hayFiltros =
          !preview && Object.keys(filtrosActuales()).length > 0;
        const resultado = await listarProyectos(filtros);
        const proyectos = preview
          ? resultado.elementos.slice(0, 2)
          : resultado.elementos;
        if (summary) {
          summary.textContent = preview
            ? resumenPublicados(proyectos.length)
            : resultado.total === 0
              ? hayFiltros
                ? "No encontramos proyectos con estos criterios."
                : "Aún no hay proyectos publicados."
              : `${resultado.total} proyecto${resultado.total === 1 ? "" : "s"} encontrado${resultado.total === 1 ? "" : "s"}`;
        }
        const sinResultados = hayFiltros
          ? `<div class="col-span-full border border-border-subtle bg-card-bg px-5 py-10 text-center"><p class="mb-2 font-display text-lg font-semibold">No encontramos proyectos.</p><p class="m-0 text-sm text-text-muted">Prueba con otros filtros o vuelve a intentarlo más tarde.</p></div>`
          : `<div class="col-span-full border border-border-subtle bg-card-bg px-5 py-10 text-center"><p class="mb-2 font-display text-lg font-semibold">Aún no hay proyectos publicados.</p><p class="m-0 text-sm text-text-muted">Los proyectos académicos y de grado aparecerán aquí cuando sean publicados.</p></div>`;
        list.innerHTML = proyectos.length
          ? proyectos.map(tarjeta).join("")
          : sinResultados;
        list.setAttribute("aria-busy", "false");
        renderizarPaginacion(resultado.totalPaginas);
      } catch (error) {
        list.innerHTML = "";
        list.setAttribute("aria-busy", "false");
        setStatus(
          error instanceof Error
            ? error.message
            : "No pudimos cargar los proyectos.",
        );
        if (summary)
          summary.textContent = "No fue posible consultar los proyectos.";
      }
    };

    filters?.addEventListener("submit", (event) => {
      event.preventDefault();
      paginaActual = 1;
      guardarFiltrosEnUrl(filtrosActuales());
      actualizarIndicadorFiltros();
      cargarProyectos();
    });
    filters?.addEventListener("change", (event) => {
      if (!(event.target instanceof HTMLSelectElement)) return;
      paginaActual = 1;
      guardarFiltrosEnUrl(filtrosActuales());
      actualizarIndicadorFiltros();
      cargarProyectos();
    });
    filters?.addEventListener("reset", () => {
      window.setTimeout(() => {
        paginaActual = 1;
        guardarFiltrosEnUrl({});
        actualizarIndicadorFiltros();
        if (mobileQuery.matches) mostrarFiltrosAvanzados(false);
        cargarProyectos();
      }, 0);
    });
    filtersToggle?.addEventListener("click", () => {
      if (!advancedFilters) return;
      mostrarFiltrosAvanzados(advancedFilters.style.display === "none");
    });
    mobileQuery.addEventListener("change", (event) => {
      mostrarFiltrosAvanzados(
        event.matches ? filtrosAvanzadosActivos() > 0 : true,
      );
    });
    cargarFiltrosDesdeUrl();
    actualizarIndicadorFiltros();
    mostrarFiltrosAvanzados(
      mobileQuery.matches ? filtrosAvanzadosActivos() > 0 : true,
    );
    cargarProyectos();
  }
</script>
