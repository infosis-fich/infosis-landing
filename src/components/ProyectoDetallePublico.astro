---
import type { Proyecto } from "../tipos/proyectos";

interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;

const nombreCompleto = (nombres: string, apellidos: string) =>
  `${nombres} ${apellidos}`.trim();
const tipoTexto = (tipo: Proyecto["tipo"]) =>
  tipo === "ACA" ? "Proyecto académico" : "Proyecto de grado";
const fechaTexto = (fecha: string | null) =>
  fecha
    ? new Intl.DateTimeFormat("es-BO", { dateStyle: "medium" }).format(
        new Date(fecha),
      )
    : "Fecha no disponible";
---

<section
  class="seccion-institucional bg-surface-muted"
  aria-labelledby="detalle-proyecto-titulo"
>
  <div class="contenedor-pagina">
    <div class="mb-6 max-w-4xl md:mb-8">
      <h1
        class="m-0 max-w-4xl font-display text-2xl font-semibold leading-snug tracking-[-.01em] md:text-3xl"
        id="detalle-proyecto-titulo"
      >
        {proyecto.titulo}
      </h1>
    </div>

    <div class="grid gap-6 lg:grid-cols-[minmax(14rem,18rem)_1fr] lg:gap-8">
      <figure
        class="forma-acento mx-auto m-0 w-full max-w-[11rem] self-start overflow-hidden border border-border-subtle bg-brand-deep lg:mx-0 lg:max-w-none"
      >
        <a
          class="relative block cursor-pointer"
          href={proyecto.pdfUrl}
          target="_blank"
          rel="noreferrer"
          aria-label={`Visualizar proyecto en PDF: ${proyecto.titulo}`}
        >
          <img
            class="block aspect-[.707/1] h-auto w-full object-cover"
            src={proyecto.miniaturaUrl}
            alt={`Portada del proyecto ${proyecto.titulo}`}
          />
          <span
            class="pointer-events-none absolute right-2 bottom-2 bg-sky px-1.5 py-0.5 text-[.6rem] font-bold tracking-[.1em] text-brand-deep uppercase"
            aria-hidden="true">PDF</span
          >
        </a>
      </figure>
      <div
        class="forma-acento border border-border-subtle bg-card-bg p-5 md:p-8"
      >
        <header
          class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-border-subtle pb-5"
        >
          <p class="m-0 text-xs font-bold tracking-[.14em] text-sky uppercase">
            {tipoTexto(proyecto.tipo)}
          </p>
          <p class="m-0 text-sm text-text-muted">
            <span class="font-semibold text-text-primary">Publicado:</span>
            <time datetime={proyecto.fechaPublicacion ?? undefined}
              >{fechaTexto(proyecto.fechaPublicacion)}</time
            >
          </p>
        </header>
        <section aria-label="Información académica del proyecto">
          <dl
            class="grid gap-x-8 gap-y-5 text-sm text-text-primary sm:grid-cols-2"
          >
            <div class="sm:col-span-2">
              <dt class="mb-1 font-semibold text-text-muted">Autores</dt>
              <dd class="leading-6">
                {
                  proyecto.autores
                    .map((autor) =>
                      nombreCompleto(autor.nombres, autor.apellidos),
                    )
                    .join(", ")
                }
              </dd>
            </div>
            <div>
              <dt class="mb-1 font-semibold text-text-muted">Año del proyecto</dt>
              <dd class="leading-6">{proyecto.anioProyecto}</dd>
            </div>
            <div>
              <dt class="mb-1 font-semibold text-text-muted">Tutor</dt>
              <dd class="leading-6">
                {
                  nombreCompleto(
                    proyecto.tutor.nombres,
                    proyecto.tutor.apellidos,
                  )
                }
              </dd>
            </div>
            {
              proyecto.materia && (
                <div class="sm:col-span-2">
                  <dt class="mb-1 font-semibold text-text-muted">Materia</dt>
                  <dd class="leading-6">
                    {proyecto.materia.codigo} - {proyecto.materia.nombre}
                  </dd>
                </div>
              )
            }
          </dl>
        </section>
        <div class="mt-7 border-t border-border-subtle pt-5">
          <a
            class="boton-principal w-full cursor-pointer justify-center sm:w-auto"
            href={proyecto.pdfUrl}
            target="_blank"
            rel="noreferrer"
          >
            Visualizar proyecto en PDF <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
