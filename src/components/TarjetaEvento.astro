---
import type { Evento } from "../datos/eventos";

interface Props {
  evento: Evento;
  indice: number;
}

const { evento, indice } = Astro.props;
---

<article
  class="forma-acento group relative flex flex-col overflow-hidden border border-line bg-tint transition-[box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none"
>
  <div
    class="absolute inset-x-0 top-0 z-10 h-1 bg-brand transition-colors group-hover:bg-sky"
    aria-hidden="true"
  >
  </div>
  <button
    class="grid h-52 w-full cursor-zoom-in place-items-center overflow-hidden bg-gradient-to-br from-brand-deep via-brand/70 to-brand-deep p-0 sm:h-60"
    type="button"
    data-visor-index={indice}
    data-visor-grupo="eventos"
    data-visor-imagen-origen
    data-image-src={evento.imagen}
    data-image-alt={evento.textoAlternativoImagen}
    data-image-title={evento.nombre}
    aria-label={`Ampliar afiche de ${evento.nombre}`}
  >
    <img
      class="max-h-full w-auto max-w-full object-contain transition-transform duration-300 hover:scale-[1.015] motion-reduce:transition-none"
      src={evento.imagen}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </button>
  <div class="flex min-w-0 flex-1 flex-col p-5 md:p-6">
    <p
      class="forma-acento mb-3 w-fit border border-sky/30 bg-sky/10 px-3 py-1.5 text-xs font-semibold text-sky"
    >
      {evento.tipo}
    </p>
    <h3 class="mb-2 font-display text-xl font-semibold">{evento.nombre}</h3>
    <p class="mb-3 text-sm font-semibold text-ink">{evento.fechas}</p>
    <p class="mb-5 text-sm leading-6 text-muted">{evento.descripcion}</p>
    <button
      class="mt-auto flex w-full cursor-pointer items-center justify-between border-t border-line pt-3 text-left font-semibold text-sky transition-colors hover:text-sky focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      type="button"
      data-visor-index={indice}
      data-visor-grupo="eventos"
    >
      Ver afiche <span aria-hidden="true">↗</span>
    </button>
  </div>
</article>
