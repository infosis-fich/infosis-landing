---
import MigasNavegacion from "./MigasNavegacion.astro";

interface ItemMiga {
  texto: string;
  href?: string;
}

interface Props {
  migas: ItemMiga[];
}

const { migas } = Astro.props;
---

<section class="border-b border-border-subtle bg-card-bg py-5">
  <div class="contenedor-pagina">
    <MigasNavegacion items={migas} />
  </div>
</section>
