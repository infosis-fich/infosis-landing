---
import { siGithub, siTiktok, siWhatsapp } from "simple-icons";
import { carreras } from "../datos/carreras";
---

<footer
  class="border-t border-border-subtle bg-card-bg py-14 pb-8 text-text-primary max-[600px]:py-10 max-[600px]:pb-6"
  id="contacto"
>
  <div
    class="contenedor-pagina grid grid-cols-[1.25fr_.9fr_1fr_1fr] items-start gap-8 max-[900px]:grid-cols-2 max-[600px]:gap-6 max-[600px]:grid-cols-2 max-[420px]:grid-cols-1"
  >
    <div class="max-[600px]:col-span-2 max-[420px]:col-span-1">
      <div class="mb-4 flex items-start gap-3">
        <img
          class="size-10 shrink-0 object-contain"
          src="/escudo-infosis.webp"
          alt=""
          width="96"
          height="96"
          loading="lazy"
          decoding="async"
        />
        <h2
          class="max-w-[400px] font-display text-xl font-bold leading-tight tracking-[-.03em]"
        >
          Dirección de Carrera de Informática y Sistemas
        </h2>
      </div>
      <p class="mb-0 text-sm leading-6 text-text-muted">
        Facultad Integral del Chaco · Camiri, Bolivia
      </p>
    </div>

    <nav
      class="max-[600px]:col-span-2 max-[420px]:col-span-1"
      aria-label="Enlaces del sitio"
    >
      <h3 class="mb-4 font-display text-base font-bold">Explora</h3>
      <ul
        class="m-0 grid list-none gap-3 p-0 text-sm text-text-muted max-[600px]:grid-cols-2 max-[420px]:grid-cols-1 max-[600px]:gap-x-6 max-[600px]:gap-y-2.5"
      >
        <li>
          <a class="transition-colors hover:text-sky" href="/#carreras"
            >Carreras</a
          >
        </li>
        {
          carreras.map((carrera) => (
            <li>
              <a class="transition-colors hover:text-sky" href={carrera.ruta}>
                {carrera.nombre}
              </a>
            </li>
          ))
        }
        <li>
          <a class="transition-colors hover:text-sky" href="/#centros"
            >Centros</a
          >
        </li>
        <li>
          <a
            class="transition-colors hover:text-sky"
            href="/#vida-universitaria">Más oportunidades</a
          >
        </li>
        <li>
          <a class="transition-colors hover:text-sky" href="/#galeria"
            >Galería</a
          >
        </li>
        <li>
          <a class="transition-colors hover:text-sky" href="/egresados"
            >Registro de egresados</a
          >
        </li>
      </ul>
    </nav>

    <div>
      <h3 class="mb-4 font-display text-base font-bold">Contacto</h3>
      <a
        class="break-words text-sm text-text-muted underline decoration-border-subtle underline-offset-4 transition-colors hover:text-sky"
        href="mailto:c_informatica.fich@uagrm.edu.bo"
      >
        c_informatica.fich@uagrm.edu.bo
      </a>
      <p class="mt-4 mb-0 text-sm leading-6 text-text-muted">
        Av. Humberto Suárez Roca, Camiri, Bolivia
      </p>
    </div>

    <div>
      <h3 class="mb-4 font-display text-base font-bold">Más información</h3>
      <nav
        class="grid gap-3 text-sm text-text-muted"
        aria-label="Contacto y enlaces externos"
      >
        <a
          class="flex items-center gap-2 transition-colors hover:text-sky"
          href="https://wa.me/59176660753?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20los%20requisitos%2C%20fechas%20y%20proceso%20de%20admisi%C3%B3n%20para%20Ingenier%C3%ADa%20Inform%C3%A1tica%20e%20Ingenier%C3%ADa%20en%20Sistemas."
          target="_blank"
          rel="noreferrer"
        >
          <span class="grid size-5 place-items-center" aria-hidden="true"
            ><svg viewBox="0 0 24 24" fill="currentColor"
              ><path d={siWhatsapp.path}></path></svg
            ></span
          >
          Consultar por WhatsApp
        </a>
        <a
          class="flex items-center gap-2 transition-colors hover:text-sky"
          href="https://github.com/infosis-fich/infosis-landing"
          target="_blank"
          rel="noreferrer"
        >
          <span class="grid size-5 place-items-center" aria-hidden="true"
            ><svg viewBox="0 0 24 24" fill="currentColor"
              ><path d={siGithub.path}></path></svg
            ></span
          >
          Código fuente · MIT
        </a>
        <a
          class="flex items-center gap-2 transition-colors hover:text-sky"
          href="https://www.tiktok.com/@infosis.uagrm.fich"
          target="_blank"
          rel="noreferrer"
        >
          <span class="grid size-5 place-items-center" aria-hidden="true"
            ><svg viewBox="0 0 24 24" fill="currentColor"
              ><path d={siTiktok.path}></path></svg
            ></span
          >
          TikTok
        </a>
      </nav>
      <button
        class="mt-5 inline-flex cursor-pointer items-center gap-2 rounded-md border border-border-subtle px-3 py-2 text-sm text-text-muted transition-colors hover:border-sky hover:text-sky focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-accent"
        type="button"
        aria-label="Activar tema claro"
        aria-pressed="false"
        title="Activar tema claro"
        data-theme-toggle
      >
        <span class="grid size-5 place-items-center" aria-hidden="true">
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-theme-moon
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
          </svg>
          <svg
            class="hidden size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            data-theme-sun
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
        </span>
        Cambiar tema
      </button>
    </div>

    <p
      class="col-span-full mt-2 mb-0 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 border-t border-border-subtle pt-6 text-center text-[.8rem] text-text-muted max-[600px]:col-span-2 max-[420px]:col-span-1"
    >
      <span>© {new Date().getFullYear()}</span>
      <span aria-hidden="true">·</span>
      <span
        >Hecho con <span class="text-sky" aria-label="amor">❤</span> por <a
          class="font-semibold transition-colors hover:text-sky"
          href="https://github.com/feresdev"
          target="_blank"
          rel="noreferrer">feresdev</a
        ></span
      >
    </p>
  </div>
</footer>

<script>
  import { CLAVE_TEMA, normalizarTema } from "../lib/tema";

  const themeToggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const themeMoon =
    themeToggle?.querySelector<HTMLElement>("[data-theme-moon]");
  const themeSun = themeToggle?.querySelector<HTMLElement>("[data-theme-sun]");
  const root = document.documentElement;

  if (themeToggle && themeMoon && themeSun) {
    const actualizarTema = (tema: "dark" | "light") => {
      const esClaro = tema === "light";
      root.classList.toggle("light", esClaro);
      themeToggle.setAttribute("aria-pressed", String(esClaro));
      themeToggle.setAttribute(
        "aria-label",
        esClaro ? "Activar tema oscuro" : "Activar tema claro",
      );
      themeToggle.title = esClaro
        ? "Activar tema oscuro"
        : "Activar tema claro";
      themeMoon.classList.toggle("hidden", esClaro);
      themeSun.classList.toggle("hidden", !esClaro);
    };

    let temaInicial: "dark" | "light" = root.classList.contains("light")
      ? "light"
      : "dark";

    try {
      temaInicial = normalizarTema(localStorage.getItem(CLAVE_TEMA));
    } catch {}

    actualizarTema(temaInicial);

    themeToggle.addEventListener("click", () => {
      const nuevoTema = root.classList.contains("light") ? "dark" : "light";
      actualizarTema(nuevoTema);

      try {
        localStorage.setItem(CLAVE_TEMA, nuevoTema);
      } catch {}
    });

    window.addEventListener("storage", (event) => {
      if (event.key === CLAVE_TEMA) {
        actualizarTema(normalizarTema(event.newValue));
      }
    });
  }
</script>
