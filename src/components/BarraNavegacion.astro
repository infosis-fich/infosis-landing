---
const enlaces = [
  ["#carreras", "Carreras"],
  ["#centros", "Centros"],
  ["#vida-universitaria", "Vida universitaria"],
  ["#eventos", "Eventos"],
];
const esInicio = Astro.url.pathname === "/";
---

<a
  class="absolute -top-16 left-4 z-50 bg-ice px-4 py-3 text-brand-deep focus:top-4 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-accent"
  href={esInicio ? "#contenido" : "/#contenido"}>Saltar al contenido</a
>
<header
  class="sticky top-0 z-40 border-b border-line/70 bg-paper/95 backdrop-blur-[14px]"
>
  <span
    class="textura-tecnica textura-lateral pointer-events-none absolute inset-y-0 left-0 z-0 hidden md:block"
    aria-hidden="true"></span>
  <span
    class="textura-tecnica textura-lateral pointer-events-none absolute inset-y-0 right-0 z-0 hidden md:block"
    aria-hidden="true"></span>
  <div
    class="contenedor-pagina relative z-10 flex min-h-[72px] items-center justify-between gap-6 max-[820px]:min-h-0 max-[820px]:flex-col max-[820px]:items-start max-[820px]:gap-1.5 max-[820px]:py-2"
  >
    <a
      class="inline-flex items-center gap-3 font-heading text-base font-bold leading-[1.1] tracking-[-.025em]"
      href={esInicio ? "#inicio" : "/"}
      aria-label="Dirección de Carrera de Informática y Sistemas, inicio"
    >
      <img
        class="size-11 object-contain"
        src="/escudo-infosis.png"
        alt=""
        width="96"
        height="96"
      />
      <span>
        Informática y Sistemas
        <small
          class="mt-1 block font-sans text-[.68rem] font-medium tracking-[.06em] text-muted"
        >
          FICH · UAGRM
        </small>
      </span>
    </a>
    <nav
      class="flex items-center gap-[clamp(.9rem,2vw,1.5rem)] text-sm font-medium text-ink max-[820px]:w-full max-[820px]:gap-5 max-[820px]:overflow-x-auto max-[820px]:pb-0.5 max-[820px]:text-[.825rem]"
      aria-label="Navegación principal"
    >
      {
        enlaces.map(([href, texto]) => (
          <a
            class="whitespace-nowrap py-2 transition-colors duration-200 hover:text-sky"
            href={esInicio ? href : `/${href}`}
          >
            {texto}
          </a>
        ))
      }
      <a
        class="boton-principal whitespace-nowrap px-3.5 py-2 text-sm max-[820px]:px-3 max-[820px]:py-1.5 max-[820px]:text-[.825rem]"
        href={esInicio ? "#admision" : "/#admision"}
        >Admisión <span aria-hidden="true">↗</span></a
      >
    </nav>
  </div>
</header>
