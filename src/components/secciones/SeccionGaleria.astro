---
import { galeriaInstitucional } from "../../datos/galeria";
import CarruselGaleria from "../CarruselGaleria.astro";
import EncabezadoSeccion from "../EncabezadoSeccion.astro";
import VisorImagenes from "../VisorImagenes.astro";

const grupos = [
  {
    nombre: "Comunidad universitaria",
    grupo: "Comunidad",
  },
  {
    nombre: "Formación y capacitación",
    grupo: "Capacitación",
  },
  {
    nombre: "Laboratorio de cómputo",
    grupo: "Cómputo",
  },
  {
    nombre: "Hardware y redes",
    grupo: "Hardware y redes",
  },
] as const;
const secciones = grupos.map((grupo) => ({
  ...grupo,
  imagenes: galeriaInstitucional.filter(
    (imagen) => imagen.grupo === grupo.grupo,
  ),
}));
let indiceInicial = 0;
const seccionesConIndice = secciones.map((seccion) => {
  const resultado = { ...seccion, indiceInicial };
  indiceInicial += seccion.imagenes.length;
  return resultado;
});
---

<section
  class="border-y border-line bg-tint py-[clamp(3.5rem,5vw,4.5rem)]"
  id="galeria"
  aria-labelledby="galeria-titulo"
>
  <div class="contenedor-pagina">
    <EncabezadoSeccion
      eyebrow="Nuestra comunidad"
      titulo="Aprendemos haciendo."
      descripcion="Conoce nuestras aulas, laboratorios y actividades."
      id="galeria-titulo"
    />
    <div
      class="grid grid-cols-2 gap-8 max-[720px]:grid-cols-1 max-[720px]:gap-4"
    >
      {
        seccionesConIndice.map(
          ({ nombre, imagenes, indiceInicial: inicio }) => (
            <div>
              <h3 class="mb-4 font-display text-lg font-bold text-ink max-[720px]:mb-2 max-[720px]:text-base">
                {nombre}
              </h3>
              <CarruselGaleria
                imagenes={imagenes}
                indiceInicial={inicio}
                etiqueta={nombre}
              />
            </div>
          ),
        )
      }
    </div>
    <VisorImagenes
      grupo="galeria"
      imagenes={galeriaInstitucional.map((imagen) => ({
        src: imagen.src,
        alt: imagen.alt,
        titulo: imagen.nombre,
      }))}
    />
  </div>
</section>
