---
import { eventos } from "../../datos/eventos";
import EncabezadoSeccion from "../EncabezadoSeccion.astro";
import TarjetaEvento from "../TarjetaEvento.astro";
import VisorImagenes from "../VisorImagenes.astro";
---

<section
  class="border-y border-line bg-paper py-[clamp(3.5rem,5vw,4.5rem)]"
  id="eventos"
  aria-labelledby="eventos-titulo"
>
  <div class="contenedor-pagina">
    <EncabezadoSeccion
      eyebrow="Noticias y actividades"
      titulo="Eventos para aprender, participar y compartir."
      descripcion="Conoce las actividades académicas e institucionales de la carrera."
      id="eventos-titulo"
    />
    <div
      class="relative min-w-0 max-[720px]:overflow-hidden"
      data-eventos-carrusel
    >
      <button
        class="pointer-events-none absolute top-1/2 left-2 z-10 hidden size-10 -translate-y-1/2 cursor-pointer place-items-center rounded-full border border-sky/30 bg-brand-deep/85 text-2xl text-ice opacity-0 shadow-lg transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky max-[720px]:pointer-events-auto max-[720px]:grid max-[720px]:opacity-100"
        type="button"
        data-eventos-anterior
        aria-label="Ver actividad anterior"
      >
        <span aria-hidden="true">‹</span>
      </button>
      <div
        class="grid grid-cols-2 gap-5 max-[720px]:flex max-[720px]:snap-x max-[720px]:snap-mandatory max-[720px]:gap-4 max-[720px]:overflow-x-auto max-[720px]:pb-3"
        data-eventos-pista
      >
        {
          eventos.map((evento, indice) => (
            <TarjetaEvento evento={evento} indice={indice} />
          ))
        }
      </div>
      <button
        class="pointer-events-none absolute top-1/2 right-2 z-10 hidden size-10 -translate-y-1/2 cursor-pointer place-items-center rounded-full border border-sky/30 bg-brand-deep/85 text-2xl text-ice opacity-0 shadow-lg transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky max-[720px]:pointer-events-auto max-[720px]:grid max-[720px]:opacity-100"
        type="button"
        data-eventos-siguiente
        aria-label="Ver siguiente actividad"
      >
        <span aria-hidden="true">›</span>
      </button>
    </div>
    <VisorImagenes
      grupo="eventos"
      imagenes={eventos.map((evento) => ({
        src: evento.imagen,
        alt: evento.textoAlternativoImagen,
        titulo: evento.nombre,
      }))}
    />
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-eventos-carrusel]")
    .forEach((carrusel) => {
      const pista = carrusel.querySelector<HTMLElement>("[data-eventos-pista]");
      const anterior = carrusel.querySelector<HTMLButtonElement>(
        "[data-eventos-anterior]",
      );
      const siguiente = carrusel.querySelector<HTMLButtonElement>(
        "[data-eventos-siguiente]",
      );

      if (!pista) return;

      const desplazar = (direccion: number) => {
        pista.scrollBy({
          left: direccion * pista.clientWidth * 0.9,
          behavior: "smooth",
        });
      };

      anterior?.addEventListener("click", () => desplazar(-1));
      siguiente?.addEventListener("click", () => desplazar(1));
    });
</script>
