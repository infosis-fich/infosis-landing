---
import EncabezadoSeccion from "../EncabezadoSeccion.astro";
---

<section
  class="fondo-admision border-y border-line py-[clamp(3.5rem,5vw,4.5rem)] text-ice"
  id="admision"
  aria-labelledby="admision-titulo"
>
  <div class="contenedor-pagina">
    <EncabezadoSeccion
      eyebrow="Admisión"
      titulo="¿Quieres estudiar con nosotros?"
      descripcion="Consulta con la Dirección de Carrera la información oficial sobre el proceso de admisión a Ingeniería Informática e Ingeniería en Sistemas."
      id="admision-titulo"
      tono="oscuro"
    />
    <div>
      <a
        class="boton-principal"
        href="https://wa.me/59176660753?text=Hola%2C%20escribo%20desde%20el%20sitio%20oficial%20de%20la%20Direcci%C3%B3n%20de%20Carrera%20de%20Inform%C3%A1tica%20y%20Sistemas%20de%20la%20FICH.%20Requiero%20informaci%C3%B3n%20sobre%20el%20proceso%20de%20admisi%C3%B3n."
        target="_blank"
        rel="noreferrer"
      >
        Consultar por WhatsApp <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
